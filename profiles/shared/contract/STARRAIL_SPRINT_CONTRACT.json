{
  "schema_version": "aemeth-sprint.v1",
  "purpose": "Run a small, ordered evidence sprint with one vocabulary shared by Claude, Codex, and the bounded Hermes Aemeth adapter.",
  "protected_meanings": {
    "Aemeth": "The data-driven sprint schema plus validation and feedback loop that refuses unproven work.",
    "Stelle": "One named executable step with input, output, verification, and exception contracts.",
    "StarrailTopology": "The directed graph of Stelle steps, artifacts, scope boundary, dependency edges, and feedback edges.",
    "Trailblazer": "The executor that validates and traverses a StarrailTopology, emits a durable receipt, and blocks failed gates."
  },
  "session_aliases": {
    "Aemeth": ["Aemeth", "에이메스"],
    "Stelle": ["Stelle", "스텔레"],
    "StarrailTopology": ["StarrailTopology", "스타레일 토폴로지", "스타레일"],
    "Trailblazer": ["Trailblazer", "개척자", "개척자Trailblazer"]
  },
  "executable_identifiers": {
    "Aemeth": {"object": "AemethExecutionLanguage", "function": "New-AemethSprint", "python_function": "NewAemethSprint"},
    "Stelle": {"object": "StelleStepContract", "function": "New-StelleStep", "python_function": "NewStelleStep"},
    "StarrailTopology": {"object": "StarrailTopologyGraph", "function": "New-StarrailTopology", "python_function": "NewStarrailTopology"},
    "Trailblazer": {"object": "TrailblazerExecutor", "function": "Invoke-Trailblazer", "python_function": "InvokeTrailblazer"}
  },
  "input_schema": "starrail-topology.v1",
  "receipt_schema": "trailblazer-run-receipt.v1",
  "receipt_write_root": ".runtime/starrail-sprint",
  "required_stelle_contract": ["input", "output", "verification", "exception"],
  "aemeth_success_status": "PASS",
  "evidence_required": true,
  "exception_policies": ["stop", "feedback"],
  "required_topology_contract": ["steps", "artifacts", "boundary", "feedback_edges"],
  "profiles": ["claude", "codex"],
  "compatibility": {
    "adapter_contract": "public-json-fields",
    "profile_required": false,
    "consumers": ["hermes", "hermes-worker"],
    "hermes_adapter": {
      "kind": "bounded-aemeth-home",
      "home": ".runtime/hermes-home",
      "skill": "skills/starrail-sprint/SKILL.md",
      "contract": "shared/contract/STARRAIL_SPRINT_CONTRACT.json",
      "reload": "/reload-skills-or-restart"
    },
    "fields": {
      "worker_role": "compatibility.worker_role",
      "route": "compatibility.route",
      "topology_id": "topology_id",
      "run_status": "status",
      "step_evidence": "steps[].evidence"
    }
  }
}
